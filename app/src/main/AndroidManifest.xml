<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Media is imported through the system Photo Picker, which needs no storage permission. -->
    <!-- INTERNET is for user-initiated model downloads and optional cloud AI (later stages). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voiceover recording inside the editor (asked only when the user taps Record). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+ package visibility: the phone's text-to-speech engine and speech recogniser. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name="com.cinemind.app.di.CineMindApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CineMind"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.cinemind.feature.export.service.ExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Keeps long jobs (speech-to-text, Smart edit…) running while the app is in the background. -->
        <service
            android:name="com.cinemind.core.common.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <service
            android:name="com.cinemind.feature.ai.llm.ondevice.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shares copies of chosen media with the app that runs a provider (e.g. Claude for KATANA). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.handoff"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/handoff_paths" />
        </provider>

        <!-- Optional GPU libraries for on-device AI (LiteRT-LM); absent on some phones. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

    </application>

</manifest>
