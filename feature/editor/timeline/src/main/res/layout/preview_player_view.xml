<?xml version="1.0" encoding="utf-8"?>
<!-- SurfaceView: the preview is rendered by Media3's CompositionPlayer (same effects as export), which
     draws into a SurfaceView. Transitions are rendered in the video itself, not by Compose. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="#FF000000"
    app:keep_content_on_player_reset="true" />
